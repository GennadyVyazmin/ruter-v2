[Unit]
Description=Ruter v2 LAN routing (private table 220)
Wants=ruter-v2-core.service
PartOf=ruter-v2-core.service
After=ruter-v2-core.service

[Service]
Type=simple
ExecStart=/opt/ruter-v2/route.sh watch
ExecStopPost=/opt/ruter-v2/route.sh stop
Restart=on-failure
RestartSec=3
TimeoutStartSec=25
TimeoutStopSec=25

[Install]
WantedBy=multi-user.target
